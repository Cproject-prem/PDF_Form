# ============================================================
# FormForge — Backend environment (copy to `.env` before running)
# ============================================================

# --- MongoDB ---
# Point to a locally-running Mongo (install locally OR use `docker compose up mongo`)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="formforge"

# --- App ---
APP_NAME="formforge"
CORS_ORIGINS="*"

# --- Auth ---
# Use a long random string in production. Any 32+ char hex will do for local dev.
JWT_SECRET="change-me-to-a-long-random-hex-string-locally"
JWT_EXPIRE_HOURS="24"

# --- Seed super-admin (created on first boot if missing) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_ADMIN_NAME="Super Admin"

# --- Uploads ---
MAX_UPLOAD_MB="25"
# Storage roots (absolute paths). All folders are created on boot if missing
# so the container starts cleanly on a fresh disk / volume mount.
# Defaults are set below to match the built-in `./uploads/...` layout.
LOCAL_UPLOAD_ROOT="/app/backend/uploads/local"
LOCAL_PLANT_DOCS_ROOT="/app/backend/uploads/local/plants"
LOCAL_PDF_TEMPLATES_ROOT="/app/backend/uploads/pdf"
LOCAL_COMPLETED_PDF_ROOT="/app/backend/uploads/completed"
LOCAL_ASSETS_ROOT="/app/backend/uploads/assets"
# --- Backups ---
BACKUP_ROOT="/app/backend/uploads/backups"
BACKUP_RETENTION_DAYS="3"

# --- Backup binaries (Windows only, optional) ---
# On Linux/Mac these ship on PATH (or are apt-installed). On Windows, either
# add the MongoDB Database Tools `bin` folder to PATH, or point directly:
# MONGODUMP_BIN="C:\Program Files\MongoDB\Tools\mongodb-database-tools-windows-x86_64-100.17.0\bin\mongodump.exe"
# MONGORESTORE_BIN="C:\Program Files\MongoDB\Tools\mongodb-database-tools-windows-x86_64-100.17.0\bin\mongorestore.exe"

# --- Security ---
# STRICT mode refuses to start if JWT_SECRET is weak or CORS is wildcard.
# Set to "false" on dev machines. Leave unset (defaults to "true") in prod.
SECURITY_STRICT="false"

# Turn ON only when serving over HTTPS behind a reverse proxy — adds HSTS header.
SECURITY_HTTPS="false"

# Login brute-force protection (defaults: 8 attempts / 15 min)
LOGIN_MAX_ATTEMPTS="8"
LOGIN_WINDOW_SECONDS="900"

# Public-submit & upload throttling (per-minute)
SUBMIT_MAX_PER_MIN="20"
UPLOAD_MAX_PER_MIN="30"

# --- Optional: Isolated AI Microservice Integration ---
# Core FormForge operates 100% normally even if AI is disabled or unavailable.
AI_ENABLED="true"
AI_SERVICE_URL="http://localhost:9000"
AI_REQUEST_TIMEOUT="30.0"
AI_CONNECT_TIMEOUT="5.0"
AI_PROVIDER="local"  # Local Ollama / Gemma AI Engine
# OLLAMA_URL="http://localhost:11434"



# --- Optional: SMTP for email notifications ---
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="no-reply@formforge.local"
