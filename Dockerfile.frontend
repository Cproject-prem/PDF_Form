# FormForge Frontend — production image
# --------------------------------------
# Stage 1 — build the React static bundle.  Stage 2 — serve via nginx.

FROM node:20-alpine AS build

WORKDIR /app/frontend

# Install deps first for cache friendliness.
COPY frontend/package.json frontend/yarn.lock ./
RUN yarn install --frozen-lockfile --network-timeout 600000

# Copy source and build.
COPY frontend/ .

# The REACT_APP_BACKEND_URL is baked at build time; pass it via
# `--build-arg REACT_APP_BACKEND_URL=https://your.domain`.  When empty the
# frontend uses same-origin relative paths — which is what the docker
# compose setup does (nginx sits in front).
ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}

RUN yarn build

# ----- Stage 2 -----
FROM nginx:1.27-alpine AS runtime

# Static assets served by nginx.
COPY --from=build /app/frontend/build /usr/share/nginx/html

# Simple config — the top-level `nginx/default.conf` overrides this when
# the docker-compose file mounts a custom config over it.
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
