# FormForge Frontend — production image
# --------------------------------------
# Stage 1 — build the React static bundle.  Stage 2 — serve via nginx.

FROM node:20-alpine AS build

WORKDIR /app/frontend

# Install deps first for cache friendliness.
COPY frontend/package*.json ./
RUN npm install --legacy-peer-deps

# Copy source and build.
COPY frontend/ .

ARG REACT_APP_BACKEND_URL=""
ENV REACT_APP_BACKEND_URL=${REACT_APP_BACKEND_URL}

RUN npm run build

# ----- Stage 2 -----
FROM nginx:1.27-alpine AS runtime

# Static assets served by nginx.
COPY --from=build /app/frontend/build /usr/share/nginx/html

# Simple config — the top-level `nginx/default.conf` overrides this when
# the docker-compose file mounts a custom config over it.
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
