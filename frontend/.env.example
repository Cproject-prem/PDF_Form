# ============================================================
# FormForge — Frontend environment (copy to `.env` before running)
# ============================================================

# Where the backend lives. Pick ONE of the four patterns below:
#
#   1. Same-origin production (recommended for DNS deployments)
#      → REACT_APP_BACKEND_URL=""    (empty!)
#      Your nginx / reverse-proxy serves both the React static files AND
#      proxies /api to FastAPI on the same DNS.  The browser stays on one
#      domain — no CORS, no mixed-content warnings.  See /app/deploy/README.md.
#
#   2. Separate API subdomain
#      → REACT_APP_BACKEND_URL=https://api.mycompany.com
#
#   3. Local dev on this PC only
#      → REACT_APP_BACKEND_URL=http://localhost:8001
#
#   4. LAN dev (open the app from your phone/other PC by IP)
#      → REACT_APP_BACKEND_URL=http://localhost:8001
#      The frontend auto-rewrites `localhost` to whatever host the browser
#      is currently using, so no change needed.  Just make sure Windows
#      Firewall lets port 8001 through.
REACT_APP_BACKEND_URL=http://localhost:8001

# For CRA/craco dev-server hot reload over HTTPS proxies (safe to keep 3000 locally)
WDS_SOCKET_PORT=3000

# Disable the platform health-check overlay when running locally
ENABLE_HEALTH_CHECK=false
